{
    "manufacturer": "wzkj",
    "type": "esp32-p4-ai-xiaowei-plus",
    "target": "esp32p4",
    "builds": [
        {
            "name": "esp32-p4-ai-xiaowei-plus",
            "sdkconfig_append": [
                "CONFIG_ESP_HOSTED_ENABLED=y",
                "CONFIG_FREERTOS_HZ=1000",
                "CONFIG_SLAVE_IDF_TARGET_ESP32C61=y",
                "CONFIG_ESP_HOSTED_CP_TARGET_ESP32C61=y",
                "CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y",
                "CONFIG_ESP_HOSTED_SDIO_SLOT_1=y",
                "CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y",
                "CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000",
                "CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=14",
                "CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=15",
                "CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=13",
                "CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=12",
                "CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=11",
                "CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=10",
                "CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=7",
                "CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y",
                "CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y",
                "CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=10",
                "CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=16",
                "CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=16",
                "CONFIG_WIFI_RMT_AMPDU_TX_ENABLED=y",
                "CONFIG_WIFI_RMT_TX_BA_WIN=16",
                "CONFIG_WIFI_RMT_AMPDU_RX_ENABLED=y",
                "CONFIG_WIFI_RMT_RX_BA_WIN=16"
            ]
        }
    ]
}
